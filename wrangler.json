{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "FIREBASE_CLIENT_EMAIL": "your-service-account@vectorizerr.iam.gserviceaccount.com",
    "FIREBASE_PROJECT_ID": "vectorizerr",
    "REQUIRED_CONFIRMATIONS": "1",
    "SUPPORT_EMAIL": "your-support-email@example.com"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TRANSACTION_SCHEDULER",
        "class_name": "TransactionScheduler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TransactionScheduler"]
    }
  ]
}
