{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vectorizerr-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "FIREBASE_PROJECT_ID": "vectorizerr",
    "REQUIRED_CONFIRMATIONS": "1"
  }
}
