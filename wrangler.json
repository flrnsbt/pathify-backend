{
  "$schema": "node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "TransactionScheduler",
        "name": "TRANSACTION_SCHEDULER"
      }
    ]
  },
  "main": "src/index.ts",
  "migrations": [
    {
      "new_sqlite_classes": [
        "TransactionScheduler"
      ],
      "tag": "v1"
    }
  ],
  "name": "api",
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "FIREBASE_CLIENT_EMAIL": "your-service-account@vectorizerr.iam.gserviceaccount.com",
    "FIREBASE_PROJECT_ID": "vectorizerr",
    "REQUIRED_CONFIRMATIONS": "1",
    "SUPPORT_EMAIL": "your-support-email@example.com",
    "EMAIL_FROM": "Pathify Support <your-support-email@example.com>"
  }
}